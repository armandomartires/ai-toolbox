{
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          { "type": "command", "timeout": 120, "command": "bash \"$CLAUDE_PROJECT_DIR/configs/claude-code/hooks/worktree-create.sh\"" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "timeout": 60, "command": "bash \"$CLAUDE_PROJECT_DIR/configs/claude-code/hooks/stop-fast-check.sh\"" }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          { "type": "command", "timeout": 120, "command": "bash \"$CLAUDE_PROJECT_DIR/configs/claude-code/hooks/worktree-remove.sh\"" }
        ]
      }
    ]
  }
}
