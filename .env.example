# ai-toolbox — environment template
#
# Copy to `.env` and fill in. `.env` is gitignored and must NEVER be
# committed. This file lists variable NAMES and MEANINGS only; it must
# never carry a real value — the same rule `mcp-servers/*/server.json`
# follows for its `environment` block (ADR-0009).
#
# Supply these either as real environment variables (exported from your
# shell profile) or via a `.env` file you source. The repo does not load
# `.env` automatically; nothing here is read by tests/validate.sh, which
# stays hermetic and must pass with none of these set.

# --- Git remotes (required to push; optional to work locally) -----------
# ADR-0007: a local git repo is mandatory, a remote is recommended.
# ADR-0028: `origin` is the intranet GitLab (primary, private); `github` is
# a public mirror. Everything except fetching/pushing works with these unset.
# None of these may ever be embedded in a remote URL (`git remote -v` must
# stay token-free), a task file, or a commit message.
# The three tokens come from Vault (ADR-0030): run the command that needs one
# through `vault_secrets.py exec <VAR> -- <command>`, which fetches it as
# secrets.map says. A value exported here or in the shell still wins.

# Base URL of the intranet GitLab instance that hosts `origin`, no path.
# Its value is internal infrastructure: never write it into a tracked file,
# since the mirror is public. Refer to it as $GITLAB_URL.
# Example shape: http://<gitlab-host>
GITLAB_URL=

# Project access token for `origin` only: `read_repository` +
# `write_repository`, Maintainer, expiring. This is what git sends. The
# instance is http:// only, so it crosses the network in cleartext, which is
# why it must be this narrow. Stored in Vault (secrets.map), not exported.
GITLAB_PUSH_TOKEN=

# Your own GitLab personal token, used only for API administration such as
# creating the project and rotating GITLAB_PUSH_TOKEN. Never used for git.
GITLAB_TOKEN=

# Base URL of the account that owns the `github` mirror.
# Example shape: https://github.com/<your-account>
GITHUB_URL=

# Personal access token with `repo` scope, used to push to the mirror.
GITHUB_TOKEN=

# --- MCP server environment --------------------------------------------
# Required by mcp-servers/ansible (see its server.json `environment`
# block). tests/validate.sh asserts every manifest's required variable is
# listed in this file, so a new server cannot introduce an undocumented
# requirement.

# Absolute path to the workspace the ansible MCP server operates on.
WORKSPACE_ROOT=

# Required by mcp-servers/gates (its pyproject.toml [tool.ai-toolbox]
# environment block). Paths in the CONSUMING repository, not this one.
# Path of the gate map (JSON) the server runs gates from, by name only.
GATES_MAP=
# Directory for per-gate state and logs; gates.txt there is the evidence file.
GATES_RUN_ROOT=
# Optional: root a map entry's cwd is relative to (default: the map's directory).
GATES_REPO_ROOT=
# Optional: watchdog default in seconds for a gate with no timeout of its own (default 3600).
GATES_TIMEOUT_SECONDS=

# --- Vault: where secret values come from (ADR-0030) --------------------
# Read by skills/vault-secrets/scripts/vault_secrets.py. None of these is a
# secret, so they may be exported from the shell profile.

# https://<vault-host>:<port>. Internal infrastructure: never write its value
# into a tracked file. http:// is refused unless the host is loopback.
VAULT_ADDR=
# PEM file of the internal root CA that issued Vault's certificate. Omit when
# the system trust store already holds it.
VAULT_CACERT=
# Optional: ldap (default) or token.
VAULT_AUTH_METHOD=
# Optional: the auth mount path (default: ldap).
VAULT_AUTH_MOUNT=
# Optional: the login name for ldap (default: the current user).
VAULT_USER=
# Optional: a token to use instead of ~/.vault-token. Never export it from a
# profile; `login` keeps a narrow, expiring one in that file instead.
VAULT_TOKEN=
